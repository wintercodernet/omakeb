{
  // omakeb menu definition. Walked by bin/omakeb-menu.
  //
  // Schema (contract C4, copied from upstream Omarchy so the shape is familiar
  // and so a future Quickshell renderer can read the same file):
  //
  //   IDs are object keys. Dotted IDs imply hierarchy: "system.lock" is a row
  //   inside the "system" submenu, which is itself a root row.
  //
  //   Kind is inferred. A row with "action" is a leaf that runs a shell command.
  //   A row without one is a submenu, and is hidden if nothing declares a child
  //   under it.
  //
  //   Fields:
  //     icon      Nerd Font glyph shown in the icon column.
  //     label     Visible row title.
  //     action    Shell command, run with `bash -c`. Presence makes it a leaf.
  //     aliases   Extra routes for `omakeb-menu <route>`.
  //     when      Shell condition; the row is hidden when it fails.
  //     checked   Shell condition; appends a check mark when it succeeds.
  //     disabled  Shell condition; the row is listed but cannot be chosen.
  //
  //   Conditions and actions are single-line shell. They must not contain a
  //   literal tab or newline — the walker moves rows through jq as
  //   unit-separated lines.
  //
  // The icons are Nerd Font glyphs from the Material Design and Font Awesome
  // ranges. They render as tofu until the Nerd Font symbols package is
  // installed (tier 3, install/50-fonts.sh).
  //
  // This is JSONC: `//`, `/* */` and `#` comments and trailing commas are all
  // stripped before parsing. The stripper is string-aware, so a `//` inside a
  // URL and a `#` inside a shell condition such as `${#bgs[@]}` survive intact.
  //
  // Do not edit this file — it is overwritten on update. Put your own rows in
  // ~/.config/omakeb/menu.jsonc, which is merged over this one, field by field,
  // so reusing an id here overrides just the fields you name.

  // --- root -------------------------------------------------------------------
  "apps":    {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"action":"fuzzel"},
  "learn":   {"icon":"󰧑","label":"Learn","aliases":["docs","help"]},
  "trigger": {"icon":"󱓞","label":"Trigger","aliases":["do"]},
  "style":   {"icon":"󰏘","label":"Style","aliases":["look"]},
  "setup":   {"icon":"󰒓","label":"Setup","aliases":["settings","config"]},
  "install": {"icon":"󰉉","label":"Install","aliases":["add"]},
  "remove":  {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update":  {"icon":"󰚰","label":"Update","aliases":["refresh"]},
  "system":  {"icon":"󰐦","label":"System","aliases":["power","power-menu"]},

  // --- learn ------------------------------------------------------------------
  // Every row here opens a URL, which is the reason the comment stripper has to
  // be string-aware: `//` in `https://` is not a comment.
  "learn.keybindings": {"icon":"󰌌","label":"Keybindings","aliases":["keys","bindings"],"action":"omakeb-menu-keybindings"},
  "learn.hyprland":    {"icon":"󰖟","label":"Hyprland wiki","action":"omakeb-launch-browser 'https://wiki.hypr.land/'"},
  "learn.debian":      {"icon":"󰣚","label":"Debian reference","action":"omakeb-launch-browser 'https://www.debian.org/doc/manuals/debian-reference/'"},
  "learn.backports":   {"icon":"󰏖","label":"Debian backports","action":"omakeb-launch-browser 'https://backports.debian.org/Instructions/'"},
  "learn.neovim":      {"icon":"󰅩","label":"Neovim","action":"omakeb-launch-browser 'https://neovim.io/doc/user/'"},
  "learn.bash":        {"icon":"󱆃","label":"Bash","action":"omakeb-launch-browser 'https://devhints.io/bash'"},

  // --- trigger ----------------------------------------------------------------
  "trigger.emoji":     {"icon":"󰇲","label":"Emoji","aliases":["emoji","emojis"],"action":"omakeb-menu-emoji"},
  "trigger.clipboard": {"icon":"󰨸","label":"Clipboard","aliases":["clipboard","clip"]},
  "trigger.capture":   {"icon":"󰄀","label":"Capture","aliases":["capture","screenshot","screenrecord"]},
  "trigger.toggle":    {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.media":     {"icon":"󰝚","label":"Media","aliases":["player"],"when":"command -v playerctl >/dev/null"},
  "trigger.window":    {"icon":"󰖲","label":"Window","aliases":["windows"]},

  "trigger.clipboard.history": {"icon":"󰋚","label":"History","action":"omakeb-menu-clipboard"},
  "trigger.clipboard.wipe":    {"icon":"󰩹","label":"Wipe history","when":"command -v cliphist >/dev/null","action":"cliphist wipe && notify-send -h string:x-canonical-private-synchronous:omakeb-clipboard 'Clipboard' 'History wiped'"},

  "trigger.capture.region":        {"icon":"󰒉","label":"Screenshot region","action":"omakeb-capture-screenshot region"},
  "trigger.capture.window":        {"icon":"󰖯","label":"Screenshot window","action":"omakeb-capture-screenshot window"},
  "trigger.capture.screen":        {"icon":"󰍹","label":"Screenshot screen","action":"omakeb-capture-screenshot screen"},
  "trigger.capture.record":        {"icon":"󰑋","label":"Record screen","action":"omakeb-capture-screenrecording"},
  "trigger.capture.record-stop":   {"icon":"󰙦","label":"Stop recording","when":"pgrep -x wf-recorder >/dev/null","action":"omakeb-capture-screenrecording stop"},
  "trigger.capture.color":         {"icon":"󰃉","label":"Pick colour","action":"omakeb-capture-color"},

  // `checked` reflects the toggle-state convention in contract C3: the state
  // file existing means the toggle is on, and omakeb-toggle-enabled reports it.
  "trigger.toggle.bar":          {"icon":"󰍜","label":"Top bar","checked":"omakeb-toggle-enabled bar","action":"omakeb-toggle-bar"},
  "trigger.toggle.dnd":          {"icon":"󰂛","label":"Do not disturb","checked":"omakeb-toggle-enabled dnd","action":"omakeb-toggle-dnd"},
  "trigger.toggle.idle":         {"icon":"󰅶","label":"Lock when idle","checked":"omakeb-toggle-enabled idle","action":"omakeb-toggle-idle"},
  "trigger.toggle.nightlight":   {"icon":"󰔎","label":"Nightlight","checked":"omakeb-toggle-enabled nightlight","action":"omakeb-toggle-nightlight"},
  "trigger.toggle.transparency": {"icon":"󰂵","label":"Window transparency","checked":"omakeb-toggle-enabled transparency","action":"omakeb-toggle-transparency"},
  "trigger.toggle.gaps":         {"icon":"󰢡","label":"Window gaps","checked":"omakeb-toggle-enabled gaps","action":"omakeb-toggle-gaps"},

  "trigger.media.play": {"icon":"󰐎","label":"Play / pause","action":"playerctl play-pause"},
  "trigger.media.next": {"icon":"󰒭","label":"Next track","action":"playerctl next"},
  "trigger.media.prev": {"icon":"󰒮","label":"Previous track","action":"playerctl previous"},
  "trigger.media.stop": {"icon":"󰓛","label":"Stop","action":"playerctl stop"},

  "trigger.window.pop":    {"icon":"󰏌","label":"Pop out (float and pin)","action":"omakeb-hyprland-window-pop"},
  "trigger.window.reload": {"icon":"󰑐","label":"Reload Hyprland","action":"hyprctl reload"},

  // --- style ------------------------------------------------------------------
  // The first two rows are routes used directly by keybindings (SUPER+CTRL+SPACE
  // and SUPER+SHIFT+CTRL+SPACE), so their ids are load-bearing: renaming one
  // silently breaks a chord. They still guard on the command existing, because
  // an install interrupted before install/70-theme.sh leaves the tree without
  // it and a row that fails when chosen is worse than one that is not there.
  //
  // The theme picker lists BOTH roots — omakeb-theme-list merges the shipped
  // themes with the user's, with the user's shadowing ours by name — so an
  // imported theme shows up here with no further wiring.
  "style.theme":       {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"when":"command -v omakeb-theme-set >/dev/null","action":"t=$(omakeb-theme-list | fuzzel --dmenu --prompt='Theme  ') && [[ -n $t ]] && omakeb-theme-set \"$t\""},
  "style.background":  {"icon":"󰋩","label":"Background","aliases":["background","wallpaper"],"when":"shopt -s nullglob; bgs=(\"$OMAKEB_CONFIG\"/themes/*/backgrounds/* \"$OMAKEB_PATH\"/themes/*/backgrounds/*); (( ${#bgs[@]} ))","action":"shopt -s nullglob; bgs=(\"$OMAKEB_CONFIG\"/themes/*/backgrounds/* \"$OMAKEB_PATH\"/themes/*/backgrounds/*); bg=$(printf '%s\\n' \"${bgs[@]}\" | sort | fuzzel --dmenu --prompt='Background  ') && [[ -n $bg ]] && hyprctl hyprpaper preload \"$bg\" && hyprctl hyprpaper wallpaper \",$bg\""},

  // Palette only, and the import says so: a third-party theme's waybar.css,
  // mako.ini and hyprlock.conf are named on screen as ignored, with the reason
  // (D11). Runs in a terminal because it clones a stranger's repo and the user
  // should see the URL and the ignore list.
  "style.get-theme":   {"icon":"󰐐","label":"Get a theme","aliases":["theme-install","get-theme"],"when":"command -v omakeb-theme-install >/dev/null","action":"omakeb-launch-tui bash -c \"omakeb-theme-install; printf '\\n'; read -rsn1 -p 'Press any key to close.'\""},

  "style.hyprland":    {"icon":"󰙪","label":"Look and feel","when":"[[ -f $OMAKEB_CONFIG/hyprland.conf ]]","action":"omakeb-launch-editor \"$OMAKEB_CONFIG/hyprland.conf\""},

  // --- setup ------------------------------------------------------------------
  "setup.display":   {"icon":"󰍹","label":"Display","aliases":["display","displays","monitors"]},
  "setup.audio":     {"icon":"󰕾","label":"Audio","aliases":["audio","sound"]},
  "setup.network":   {"icon":"󰛳","label":"Network","aliases":["network","wifi"]},
  // Guarded on an ADAPTER, not on the tools: bluez and blueman are always
  // installed, so `command -v bluetoothctl` is true on every machine including
  // ones with no radio at all. Offering the row there gets you a
  // blueman-manager that dies with a Python traceback nobody sees — it lands in
  // waybar's journal, because waybar spawned it. Same test
  // as setup.nvidia uses: ask the kernel whether the hardware is there.
  "setup.bluetooth": {"icon":"󰂯","label":"Bluetooth","aliases":["bluetooth"],"when":"ls -A /sys/class/bluetooth 2>/dev/null | grep -q ."},
  "setup.files":     {"icon":"󱁿","label":"Config files","aliases":["dotfiles"]},
  // Hidden unless a PCI device of class 0x03xx reports NVIDIA's vendor id.
  // Read from sysfs rather than lspci, which a netinst does not install.
  "setup.nvidia":    {"icon":"󰢮","label":"NVIDIA","aliases":["nvidia","gpu"],"when":"grep -qs 0x10de /sys/bus/pci/devices/*/vendor"},

  "setup.display.gui":      {"icon":"󰍹","label":"Arrange displays","when":"command -v wdisplays >/dev/null","action":"omakeb-launch-once wdisplays"},
  "setup.display.list":     {"icon":"󰉹","label":"Show outputs","when":"command -v wlr-randr >/dev/null","action":"wlr-randr | fuzzel --dmenu --prompt='Outputs  ' --width=80 >/dev/null"},
  "setup.display.monitors": {"icon":"󰷈","label":"Edit monitor lines","when":"[[ -f $OMAKEB_CONFIG/hyprland.conf ]]","action":"omakeb-launch-editor \"$OMAKEB_CONFIG/hyprland.conf\""},
  "setup.display.reload":   {"icon":"󰑐","label":"Reload Hyprland","action":"hyprctl reload"},

  "setup.audio.mixer": {"icon":"󰕾","label":"Volume mixer","when":"command -v pavucontrol >/dev/null","action":"omakeb-launch-once pavucontrol"},
  "setup.audio.mute":  {"icon":"󰝟","label":"Mute output","action":"omakeb-audio-volume mute"},
  "setup.audio.mic":   {"icon":"󰍬","label":"Mute microphone","action":"omakeb-audio-volume mic-mute"},
  // Troubleshooting, below the everyday rows. `check` changes nothing; `fix`
  // prints what it would do and needs a second, explicit run to act. They are
  // here because the fault they find is invisible from the volume mixer above:
  // the meter moves and the sound is muted a layer below anything it shows.
  "setup.audio.check":    {"icon":"󰋼","label":"Check for silent audio","action":"omakeb-launch-tui bash -c \"omakeb-hw-audio; printf '\\n'; read -rsn1 -p 'Press any key to close.'\""},
  "setup.audio.repair":   {"icon":"󰖷","label":"Repair silent audio","action":"omakeb-launch-tui bash -c \"omakeb-hw-audio fix; printf '\\n'; read -rsn1 -p 'Press any key to close.'\""},
  "setup.audio.hwmixer":  {"icon":"󰆍","label":"Hardware mixer (alsamixer)","when":"command -v alsamixer >/dev/null","action":"omakeb-launch-tui alsamixer"},

  "setup.network.editor": {"icon":"󰛳","label":"Connections","when":"command -v nm-connection-editor >/dev/null","action":"omakeb-launch-once nm-connection-editor"},
  "setup.network.tui":    {"icon":"󰢩","label":"Connections (terminal)","when":"command -v nmtui >/dev/null","action":"omakeb-launch-tui nmtui"},

  "setup.bluetooth.manager": {"icon":"󰂯","label":"Devices","when":"command -v blueman-manager >/dev/null","action":"omakeb-launch-once blueman-manager"},
  "setup.bluetooth.tui":     {"icon":"󰆍","label":"Devices (terminal)","action":"omakeb-launch-tui bluetoothctl"},

  // Opt-in, and never run by the installer. `detect` and `show` change
  // nothing; `enable` summarises every change and asks first. This is the one
  // omakeb feature with no real hardware behind it, so the read-only rows come
  // first and the row that undoes it is always one keypress away.
  "setup.nvidia.detect": {"icon":"󰍉","label":"Detect graphics hardware","action":"omakeb-launch-tui bash -c \"omakeb-hw-nvidia detect; printf '\\n'; read -rsn1 -p 'Press any key to close.'\""},
  "setup.nvidia.show":   {"icon":"󰈈","label":"Show what setup would change","action":"omakeb-launch-tui bash -c \"omakeb-hw-nvidia show; printf '\\n'; read -rsn1 -p 'Press any key to close.'\""},
  "setup.nvidia.enable": {"icon":"󰉉","label":"Set up the proprietary driver","action":"omakeb-launch-tui bash -c \"omakeb-hw-nvidia enable; printf '\\n'; read -rsn1 -p 'Press any key to close.'\""},
  "setup.nvidia.revert": {"icon":"󰩹","label":"Undo the driver setup","when":"[[ -d $OMAKEB_STATE/hw-nvidia ]]","action":"omakeb-launch-tui bash -c \"omakeb-hw-nvidia revert; printf '\\n'; read -rsn1 -p 'Press any key to close.'\""},

  // The menu can edit itself. All four files are seeded once and never
  // overwritten, so editing them is always safe.
  "setup.files.apps":     {"icon":"󰣆","label":"Default applications","when":"[[ -f $OMAKEB_CONFIG/apps.conf ]]","action":"omakeb-launch-editor \"$OMAKEB_CONFIG/apps.conf\""},
  "setup.files.bindings": {"icon":"󰌌","label":"Keybindings","when":"[[ -f $OMAKEB_CONFIG/bindings.conf ]]","action":"omakeb-launch-editor \"$OMAKEB_CONFIG/bindings.conf\""},
  "setup.files.hyprland": {"icon":"󰙪","label":"Hyprland overrides","when":"[[ -f $OMAKEB_CONFIG/hyprland.conf ]]","action":"omakeb-launch-editor \"$OMAKEB_CONFIG/hyprland.conf\""},
  "setup.files.menu":     {"icon":"󰍜","label":"This menu","when":"[[ -f $OMAKEB_CONFIG/menu.jsonc ]]","action":"omakeb-launch-editor \"$OMAKEB_CONFIG/menu.jsonc\""},

  // --- install / remove -------------------------------------------------------
  // There is no AUR, so the generic rows are plain apt. The curated tier-2 and
  // tier-3 rows generated from apps/ land with the apps slice; when they do they
  // belong here as install.<category>.<app>.
  // Curated software from apps/ — the list omakeb-install-app knows. Mostly
  // tier 2 and 3; a couple are tier 1, there because they are worth offering
  // rather than because Debian lacks them (the JDK is one).
  // about. Listed first because it is what most people want; "Debian package"
  // below is the raw archive for everything else.
  "install.app": {"icon":"󰀻","label":"Application","aliases":["app-install","software"],"action":"omakeb-install-app install"},
  "install.package": {"icon":"󰏖","label":"Debian package","aliases":["apt","package"],"action":"p=$(apt-cache pkgnames 2>/dev/null | sort -u | fuzzel --dmenu --prompt='Install  ') && [[ -n $p ]] && omakeb-launch-tui bash -c \"sudo apt install '$p'; read -rsn1 -p 'Press any key to close.'\""},
  "remove.app": {"icon":"󰀻","label":"Application","aliases":["app-remove"],"action":"omakeb-install-app remove"},
  "remove.package":  {"icon":"󰩹","label":"Debian package","aliases":["apt-remove"],"action":"p=$(dpkg-query -W -f '${binary:Package}\\n' 2>/dev/null | sed 's/:.*//' | sort -u | fuzzel --dmenu --prompt='Remove  ') && [[ -n $p ]] && omakeb-launch-tui bash -c \"sudo apt remove '$p'; read -rsn1 -p 'Press any key to close.'\""},

  // --- update -----------------------------------------------------------------
  "update.omakeb":   {"icon":"󰘬","label":"omakeb","when":"command -v omakeb-update >/dev/null","action":"omakeb-launch-tui bash -c \"omakeb-update; read -rsn1 -p 'Press any key to close.'\""},
  "update.packages": {"icon":"󰏖","label":"Debian packages","action":"omakeb-launch-tui bash -c \"sudo apt update && sudo apt upgrade; read -rsn1 -p 'Press any key to close.'\""},
  "update.hyprland": {"icon":"󰑐","label":"Reload Hyprland","action":"hyprctl reload"},
  "update.menu":     {"icon":"󰗂","label":"Rebuild menu cache","action":"rm -f \"$OMAKEB_CACHE/menu.json\" \"$OMAKEB_CACHE/menu.stamp\"; notify-send -h string:x-canonical-private-synchronous:omakeb-menu 'omakeb' 'Menu cache rebuilt'"},

  // --- system -----------------------------------------------------------------
  "system.activity":  {"icon":"󰓅","label":"Activity","action":"omakeb-launch-tui btop"},
  "system.lock":      {"icon":"󰌾","label":"Lock","aliases":["lock"],"action":"omakeb-system-lock"},
  "system.suspend":   {"icon":"󰒲","label":"Suspend","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"grep -qw disk /sys/power/state","action":"systemctl hibernate"},
  "system.logout":    {"icon":"󰍃","label":"Log out","aliases":["logout"],"action":"if command -v uwsm >/dev/null && uwsm check is-active >/dev/null 2>&1; then uwsm stop; else hyprctl dispatch exit; fi"},
  "system.reboot":    {"icon":"󰜉","label":"Reboot","aliases":["reboot","restart"],"action":"systemctl reboot"},
  "system.shutdown":  {"icon":"󰐥","label":"Shut down","aliases":["shutdown","poweroff"],"action":"systemctl poweroff"},
}
