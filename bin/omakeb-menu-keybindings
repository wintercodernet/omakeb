#!/bin/bash

# omakeb:summary=Show every active keybinding in a searchable list.

# The cheatsheet is generated from the running compositor, not from a file we
# maintain alongside the config. `hyprctl binds -j` reports the description we
# attach with the `d` bind flag, so the user's own bindings in
# ~/.config/omakeb/bindings.conf show up here too, and nothing can drift.

set -euo pipefail

command -v hyprctl >/dev/null || { echo "hyprctl not found; is Hyprland running?" >&2; exit 1; }

# Hyprland reports modmask as a bitfield. Values come from wlroots/xkb modifier
# order: SHIFT=1, CAPS=2, CTRL=4, ALT=8, MOD2=16, MOD3=32, SUPER=64, MOD5=128.
# Emitted chord and description are tab-separated for the aligner below.
JQ_PROGRAM='
  # We bind the number row and the resize keys by keycode so they survive
  # non-QWERTY layouts, but "code:19" is meaningless to a reader. Translate the
  # ones we use back to the label printed on a US keyboard.
  def keyname($key; $code):
    if ($key // "") != "" then $key
    else
      { "10":"1","11":"2","12":"3","13":"4","14":"5",
        "15":"6","16":"7","17":"8","18":"9","19":"0",
        "20":"-","21":"=" }[$code | tostring] // ("code:" + ($code | tostring))
    end;

  def mods($m):
    [ if (($m / 64) | floor) % 2 == 1 then "SUPER" else empty end,
      if (($m /  4) | floor) % 2 == 1 then "CTRL"  else empty end,
      if (($m /  8) | floor) % 2 == 1 then "ALT"   else empty end,
      if (($m /  1) | floor) % 2 == 1 then "SHIFT" else empty end ]
    | join(" + ");

  map(select(.description != null and .description != ""))
  | map({
      chord: ((mods(.modmask) | if . == "" then "" else . + " + " end)
              + keyname(.key; .keycode)),
      desc:  .description
    })
  | sort_by(.desc)
  | .[]
  | "\(.chord)\t\(.desc)"
'

# Pad the chord column to the widest entry so the list reads as two columns.
hyprctl binds -j \
  | jq -r "$JQ_PROGRAM" \
  | awk -F'\t' '
      { chord[NR] = $1; desc[NR] = $2; if (length($1) > w) w = length($1) }
      END { for (i = 1; i <= NR; i++) printf "%-*s   %s\n", w, chord[i], desc[i] }
    ' \
  | fuzzel --dmenu --prompt='Keybindings  ' --width=80 >/dev/null
